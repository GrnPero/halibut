# Copy to .env and fill in. Never commit .env.

# Matches docker-compose.yml
DATABASE_URL="postgresql://halibut:halibut@localhost:5432/halibut"

# Integration tests (npm run test:integration). Same server, separate database;
# its name must end in _test. The tests empty every table in it.
DATABASE_URL_TEST="postgresql://halibut:halibut@localhost:5432/halibut_test"

# Better Auth. Generate the secret with: npx auth@latest secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# The account prisma/seed.ts seeds data for. Create the account first.
SEED_USER_EMAIL=""

# The variable names below are suggestions; nothing reads them yet.

# Claude, for the framework evaluation and alert-email parsing
ANTHROPIC_API_KEY=""

# JSearch job search API
JSEARCH_API_KEY=""

# OpenAI, for embeddings only (text-embedding-3-small)
OPENAI_API_KEY=""

# Daily scheduler, midnight local time. Off by default.
SCHEDULER_ENABLED="false"
# Which sources the daily run fetches. Add jsearch only on an always-on machine:
# it spends your JSearch requests.
SCHEDULER_SOURCES="larajobs_rss,email_alert"

# Gmail API, read-only, for the "Job Alerts" label
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Geocoding API (needs a billing account on the Google Cloud project)
GOOGLE_MAPS_API_KEY=""
GMAIL_ALERTS_LABEL="Job Alerts"
