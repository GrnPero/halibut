// Halibut: Prisma 7 schema.
//
// Conventions
// - IDs are UUIDv7 (time-sortable), stored in Postgres's native uuid type and
//   generated by Prisma Client on create.
// - Multi-user. Every Halibut table has a userId, and every query must filter
//   by it. Each user has their own jobs, companies and framework; nothing is
//   shared between users. Deleting a user deletes all of their data.
// - The User, Session, Account and Verification models at the bottom are
//   generated by Better Auth (npx auth@latest generate). Only the back-relation
//   fields on User were added by hand; re-check them after regenerating.
// - No database-level enums. Every "kind of thing" column is plain String; the
//   allowed values live in src/lib/enums.ts (Zod). Validate before every write.
// - pgvector: the first migration must run `CREATE EXTENSION IF NOT EXISTS vector;`
//   (create it with `prisma migrate dev --create-only`, then add that line).
//   Vector columns are Unsupported in Prisma 7, so similarity queries are raw SQL.
// - Embeddings: OpenAI text-embedding-3-small, 1536 numbers each. Changing the
//   model means changing this size and re-embedding everything.
// - The database URL lives in prisma.config.ts, not here (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Company: one row per employer ----------

model Company {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  normalizedName String // lowercased, punctuation and "Inc/LLC" stripped; unique per user
  domain         String?
  industry       String? // sheet column: Industry
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobs Job[]

  @@unique([userId, normalizedName])
}

// ---------- Job: one row per posting ----------

model Job {
  id           String  @id @default(uuid(7)) @db.Uuid
  userId       String  @db.Uuid
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String  @db.Uuid
  company      Company @relation(fields: [companyId], references: [id])
  title        String // sheet column: Position
  roleCategory String  @default("unknown") // RoleCategory in enums.ts; set once when the job is first saved
  description  String? // null while a job is only a stub from an alert email

  // Location. sheet column: Location. Distance is computed at query time
  // from a SearchArea, so it is not stored.
  locationRaw String?
  workMode    String  @default("unknown") // WorkMode in enums.ts
  latitude    Float?
  longitude   Float?

  // Compensation. sheet column: Salary Range (kept verbatim in salaryRaw)
  salaryRaw      String?
  salaryMin      Int?
  salaryMax      Int?
  salaryPeriod   String? // SalaryPeriod in enums.ts
  annualizedMin  Int? // hourly * 2080, computed in code
  annualizedMax  Int?
  employmentType String  @default("unknown") // EmploymentType in enums.ts

  postedAt           DateTime? @db.Date // sheet column: Date Posted; a calendar date
  originalPostingUrl String? // the link to apply through; the employer's own page wins

  // Dedupe key: SHA-256 of normalized company + title + city. A second copy of
  // the same job collides here and is attached as a JobSighting instead.
  fingerprint String // unique per user (see @@unique below)

  // Cheap rule-based filters (salary floor, excluded tech). Jobs are hidden,
  // never deleted. null = not checked yet; filterReasons says why it failed.
  passedHardFilters Boolean?
  filterReasons     String[]

  // The job's own embedding. Compared against Resume.embedding at query time.
  embedding Unsupported("vector(1536)")?

  firstFoundAt DateTime  @default(now()) // first time any source returned it
  lastFoundAt  DateTime  @default(now()) // last time any source returned it
  viewedAt     DateTime? // first time you opened it in the app
  dismissedAt  DateTime? // set by "Not interested"; the job is hidden in every resume tab

  sightings    JobSighting[]
  evaluations  Evaluation[]
  applications Application[]

  @@unique([userId, fingerprint])
  @@index([companyId])
  @@index([passedHardFilters])
}

// ---------- JobSighting: one row per place a job was found ----------
// The same job from JSearch and from an alert email is one Job, two sightings.

model JobSighting {
  id          String     @id @default(uuid(7)) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String     @db.Uuid
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source      String // SourceKind in enums.ts
  externalId  String // the source's own id, or a hash of the URL
  url         String?
  publisher   String? // e.g. "LinkedIn", "Indeed", as reported by the source
  rawPayload  Json?
  ingestRunId String?    @db.Uuid
  ingestRun   IngestRun? @relation(fields: [ingestRunId], references: [id])
  seenAt      DateTime   @default(now())

  @@unique([userId, source, externalId])
  @@index([jobId])
}

// ---------- Resume: one row per resume version (one tab each) ----------
// e.g. "Laravel", "Python + Laravel", "Next.js + Laravel".
// Tab order: the default resume first, then the rest alphabetically by label.
// Only one resume should be the default; the app enforces that when you set it.

model Resume {
  id          String                       @id @default(uuid(7)) @db.Uuid
  userId      String                       @db.Uuid
  user        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  content     String
  embedding   Unsupported("vector(1536)")?
  searchTerms String[] // phrases this resume adds to the job searches
  isDefault   Boolean                      @default(false) // the tab the app opens with; other tabs sort alphabetically
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  evaluations Evaluation[]

  @@unique([userId, label])
}

// ---------- Framework: your job evaluation framework, one row per version ----
// Rows are never edited: saving a change creates a new row, and the newest row
// (by createdAt) is the active framework. Seeded from the git-ignored file
// prompts/job-evaluation-framework.md, or the committed example if it is absent.

model Framework {
  id                 String   @id @default(uuid(7)) @db.Uuid
  userId             String   @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content            String // the framework text, used as the evaluation prompt
  salaryIdealMin     Int // annual pay at or above this is "ideal"
  salaryPreferredMin Int // at or above this is "preferred minimum"
  salaryFloor        Int // below this is "usually pass", and the hard filter hides the job
  createdAt          DateTime @default(now())

  evaluations Evaluation[]

  @@index([userId, createdAt])
}

// ---------- Evaluation: the framework verdict for a job ----------
// `result` holds the object validated by jobEvaluationSchema (evaluation.ts);
// verdict is lifted out for sorting.

model Evaluation {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String    @db.Uuid
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId     String?   @db.Uuid
  resume       Resume?   @relation(fields: [resumeId], references: [id])
  frameworkId  String    @db.Uuid // the framework version this evaluation used
  framework    Framework @relation(fields: [frameworkId], references: [id])
  model        String
  verdict      String // Verdict in enums.ts
  result       Json
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime  @default(now())

  @@index([jobId, createdAt])
}

// ---------- Application: mirrors the "Applications 2026" sheet tab ----------
//
// Sheet column -> field
//   Position, Company, Industry, Role, Location, Date Posted, Salary Range
//                    -> live on Job / Company (the import creates stub rows)
//   Date Applied     -> appliedAt
//   Connections?     -> hasConnection
//   Cover Letter     -> coverLetter
//   Résumé upload?   -> resumeUpload
//   Résumé Form?     -> resumeForm
//   Notes            -> notes
//   Status           -> status
//   Latest word      -> latestWordAt
//   contact 1        -> contactName
//   SHADE            -> shade (kept only so the export matches the sheet)

model Application {
  id                  String    @id @default(uuid(7)) @db.Uuid
  userId              String    @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId               String    @db.Uuid
  job                 Job       @relation(fields: [jobId], references: [id])
  appliedAt           DateTime? @db.Date
  hasConnection       Boolean   @default(false)
  coverLetter         Boolean   @default(false)
  resumeUpload        Boolean   @default(false)
  resumeForm          Boolean   @default(false)
  notes               String?
  status              String    @default("sent") // ApplicationStatus in enums.ts
  latestWordAt        DateTime? @db.Date
  contactName         String?
  shade               String?
  // Snapshot of the posting at apply time. Postings disappear; this is what
  // you re-read when a recruiter calls three weeks later.
  descriptionSnapshot String?
  importedFromSheet   Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([jobId])
  @@index([status])
}

// ---------- SearchArea: your home bases for the radius filter ----------
// Seeded with Pomona, Los Angeles and Redlands; editable from the UI.
// Dropdown order: the default area first, then the rest alphabetically.
// Only one area should be the default; the app enforces that when you set it.

model SearchArea {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  latitude    Float
  longitude   Float
  radiusMiles Int      @default(50)
  isDefault   Boolean  @default(false) // the area the job list opens with
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, label])
}

// ---------- IngestRun: a log line per fetch ----------

model IngestRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     String // SourceKind in enums.ts
  status     String    @default("running") // RunStatus in enums.ts
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  fetched    Int       @default(0)
  inserted   Int       @default(0)
  duplicates Int       @default(0)
  error      String?

  sightings JobSighting[]

  @@index([source, startedAt])
}

// ---------- ProcessedEmail: which alert emails are already handled ----------

model ProcessedEmail {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId     String
  sender        String
  subject       String
  receivedAt    DateTime
  jobsExtracted Int      @default(0)
  processedAt   DateTime @default(now())

  @@unique([userId, messageId])
}

// ---------- Auth: generated by Better Auth ----------
// One account per person, created from the command line (sign-up is off).

model User {
  id            String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Halibut data owned by this user (added to Better Auth's generated model)
  companies       Company[]
  jobs            Job[]
  jobSightings    JobSighting[]
  resumes         Resume[]
  frameworks      Framework[]
  evaluations     Evaluation[]
  applications    Application[]
  searchAreas     SearchArea[]
  ingestRuns      IngestRun[]
  processedEmails ProcessedEmail[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
